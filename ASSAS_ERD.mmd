---
title: ASSAS - Entity Relationship Diagram
---
erDiagram
    USER {
        int id PK
        string student_id UK
        string full_name
        string ic_passport
        string role "student | admin"
        bool is_active
        bool is_staff
        datetime date_joined
    }
    FACULTY {
        string faculty_code PK
        string faculty_name
    }
    PROGRAMME {
        string programme_code PK
        string programme_name
        string faculty_code FK "nullable"
        int total_credits
        int max_credits_per_sem
        int probation_credit_cap
        int total_semesters
    }
    STUDENT {
        int id PK
        int user_id FK, UK
        string programme_code FK
        string photo
        int current_semester
        string status
        int total_credits_earned
        decimal cgpa
        bool is_repeat
        bool is_transfer
    }
    SUBJECT {
        string subject_code PK
        string subject_name
        int credit_hours
        int semester
    }
    SUBJECT_PROGRAMMES {
        int id PK
        string subject_code FK
        string programme_code FK
    }
    PREREQUISITE {
        int id PK
        string subject_code FK
        string prerequisite_subject_code FK
    }
    ENROLMENT {
        int id PK
        int student_id FK
        string subject_code FK
        string semester "e.g. 202401"
        string status
        string grade "nullable"
        bool is_repeat
        datetime assigned_at
    }
    EXCEPTION_LOG {
        int id PK
        int student_id FK
        string subject_code FK
        int enrolment_id FK "nullable"
        string reason
        text details
        string status
        int reviewed_by FK "nullable"
        datetime reviewed_at
        datetime created_at
    }
    RULE {
        int id PK
        string rule_type
        int rule_value
        string programme_code FK "nullable"
        bool is_active
    }
    ADD_DROP_REQUEST {
        int id PK
        int student_id FK
        string subject_code FK
        string action "add | drop"
        text reason
        string status
        string semester
        int reviewed_by FK "nullable"
        datetime reviewed_at
        text admin_remarks
        datetime created_at
    }
    TIMETABLE {
        int id PK
        string title
        string semester
        string file
        int uploaded_by FK "nullable"
        datetime uploaded_at
    }
    TIMETABLE_PROGRAMMES {
        int id PK
        int timetable_id FK
        string programme_code FK
    }
    TIME_SLOT {
        int id PK
        int timetable_id FK
        string subject_code FK
        string day_of_week
        time start_time
        time end_time
        string venue "matches VENUE.name"
    }
    VENUE {
        string name PK
        int capacity
    }

    USER ||--o| STUDENT : "has profile"
    FACULTY |o--o{ PROGRAMME : "offers"
    PROGRAMME ||--o{ STUDENT : "enrols"
    PROGRAMME ||--o{ SUBJECT_PROGRAMMES : "includes"
    SUBJECT ||--o{ SUBJECT_PROGRAMMES : "belongs to"
    PROGRAMME |o--o{ RULE : "governed by"
    PROGRAMME ||--o{ TIMETABLE_PROGRAMMES : "uses"
    TIMETABLE ||--o{ TIMETABLE_PROGRAMMES : "serves"
    SUBJECT ||--o{ PREREQUISITE : "requires"
    SUBJECT ||--o{ PREREQUISITE : "is prerequisite for"
    STUDENT ||--o{ ENROLMENT : "takes"
    SUBJECT ||--o{ ENROLMENT : "enrolled in"
    STUDENT ||--o{ EXCEPTION_LOG : "raises"
    SUBJECT ||--o{ EXCEPTION_LOG : "concerns"
    ENROLMENT |o--o{ EXCEPTION_LOG : "flagged by"
    USER |o--o{ EXCEPTION_LOG : "reviews"
    STUDENT ||--o{ ADD_DROP_REQUEST : "submits"
    SUBJECT ||--o{ ADD_DROP_REQUEST : "targets"
    USER |o--o{ ADD_DROP_REQUEST : "reviews"
    USER |o--o{ TIMETABLE : "uploads"
    TIMETABLE ||--o{ TIME_SLOT : "contains"
    SUBJECT ||--o{ TIME_SLOT : "scheduled in"
    VENUE |o..o{ TIME_SLOT : "hosts (by name)"
