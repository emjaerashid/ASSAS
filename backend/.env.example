# Copy this file to backend/.env for local development. backend/.env is
# gitignored; never commit a real secret key.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# True for local development only. Leave unset (False) anywhere public.
DJANGO_DEBUG=True

# Comma-separated hostnames this server answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production only (all optional) ---
# HTTPS redirects, secure cookies and HSTS turn on automatically when
# DJANGO_DEBUG is False. DJANGO_HTTPS=False disables them for an HTTP-only box.
# DJANGO_HTTPS=True
# DJANGO_HSTS_SECONDS=3600
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_HSTS_PRELOAD=False
# Set True when a reverse proxy (nginx, a load balancer) terminates TLS.
# DJANGO_BEHIND_PROXY=False
