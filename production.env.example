# Copy to production.env (gitignored) on the server and fill in.

# Required. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Your public hostname(s) and https origin(s).
DJANGO_ALLOWED_HOSTS=assas.example.edu.my
DJANGO_CSRF_TRUSTED_ORIGINS=https://assas.example.edu.my

# Leave DEBUG off in production. HTTPS redirects, secure cookies and HSTS
# switch on automatically.
DJANGO_DEBUG=False

# True when a proxy / load balancer terminates TLS in front of the container.
DJANGO_BEHIND_PROXY=True

# Start at an hour; raise to 31536000 (one year) once HTTPS is confirmed.
DJANGO_HSTS_SECONDS=3600

# Django's built-in admin site is off unless you need it.
# DJANGO_ENABLE_ADMIN=False

# GUNICORN_WORKERS=2
# DJANGO_LOG_LEVEL=INFO
