# Copy this file to backend/.env for local development. backend/.env is
# gitignored; never commit a real secret key.

# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# True for local development only. Leave unset (False) anywhere public.
DJANGO_DEBUG=True

# Comma-separated hostnames this server answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
